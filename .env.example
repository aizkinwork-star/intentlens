# Copy this file to .env and fill in only the providers you use. .env is gitignored.
# The desktop app writes credentials to an encrypted store; environment variables
# are an alternative for headless/server runs. Keys never reach the browser.
#
# Packaged desktop app: use %APPDATA%\IntentLens\.env instead of the install
# directory. Source runs can use the project .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
DATA_DIR=./intentlens-data
# Maximum request body and inline image size in bytes.
MAX_BODY_BYTES=12582912
MAX_IMAGE_BYTES=8388608

# ---------------------------------------------------------------------------
# Provider access
# ---------------------------------------------------------------------------
# free | preview | paid. "free" hides paid models; "paid" shows all catalogued
# models and may bill your provider account. Nothing is purchased automatically.
MODEL_ACCESS_TIER=free

# Failover order. A provider is only attempted when it has a usable key and the
# selected model is vision-capable. Text-only models never receive an image.
PROVIDER_PRIORITY=openrouter,groq,google-ai-studio,nvidia-nim,cloudflare-workers-ai,mistral,cerebras,together,huggingface,deepinfra,openai,anthropic,ollama,custom

# Outbound network is disabled by default. Set true to call cloud providers.
# Local camera, grid, tracking, lighting and k-NN work with this false.
ALLOW_OUTBOUND_NETWORK=false

# ---------------------------------------------------------------------------
# Hard cost budget (USD estimates, not invoices)
# ---------------------------------------------------------------------------
# Before every provider attempt the server reserves a pessimistic worst-case
# estimate against these caps. A request that would exceed them is refused.
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=10.00
MAX_REQUEST_USD=0.25
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Provider keys and optional model overrides
# Set only the ones you have. An empty key leaves that provider unconfigured.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_ID=google/gemini-2.5-flash

GROQ_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Accepts either GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=

NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_ENABLED=true
# NIM_MODEL_ID=meta/muse-glimmer-30b

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL_ID=@cf/meta/llama-3.2-11b-vision-instruct

MISTRAL_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
# HF_TOKEN is preferred; HUGGINGFACE_API_KEY is accepted as an alias.
HF_TOKEN=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local Ollama: no key. Loopback only unless you deliberately change it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false

# Custom OpenAI-compatible relay. HTTPS is required except for loopback.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# ---------------------------------------------------------------------------
# Optional local perception modules (not required for the MVP)
# ---------------------------------------------------------------------------
LOCAL_SOURCE_DIR=./intentlens-data/sources
FAISS_ENABLED=false
