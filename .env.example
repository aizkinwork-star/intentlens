# Copy this file to .env and fill in the values. .env is gitignored.
# Keys and config are read only by the Node server and never reach the browser.
# Packaged desktop app: use %APPDATA%\IntentLens\.env instead (the install
# directory is not writable). Source runs can use the project .env.

# Meta-published models are the priority on every provider. Non-Meta fallbacks
# are explicitly labelled. No API keys in browser code.

# --- Server ---
NODE_ENV=development
PORT=8000
DATA_DIR=./intentlens-data

# --- Meta model provider configuration ---
# Primary: OpenRouter (Meta Llama 4 Maverick). Get a key at
# https://openrouter.ai/keys. This is paid per token; the UI shows the price.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL_ID=meta-llama/llama-4-maverick

# Desktop: NVIDIA NIM (Meta Muse Glimmer 30B). Get a key at
# https://build.nvidia.com/. The inference endpoint is not the dashboard URL.
NIM_ENABLED=true
NIM_API_KEY=your_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_MODEL_ID=meta/muse-glimmer-30b

# Desktop: Cloudflare Workers AI (Meta Llama 3.2 11B Vision)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL_ID=@cf/meta/llama-3.2-11b-vision-instruct

# Desktop: BlockRun (paid x402 marketplace). The supplied test key returned
# HTTP 402 Payment verification failed; add credit before expecting a reply.
BLOCKRUN_API_KEY=your_blockrun_api_key
BLOCKRUN_MODEL_ID=meta-llama/llama-4-maverick

# Desktop: Modal (paid, NOT tested). Paste your deployed OpenAI-compatible
# endpoint. It must be HTTPS on *.modal.run.
MODAL_API_KEY=your_modal_api_key
MODAL_BASE_URL=https://your-workspace--your-app.modal.run
MODAL_MODEL_ID=meta-llama/Llama-4-Maverick-17B-128E-Instruct

# Groq: text-only provider. No image input is ever sent to Groq. Llama 3.3 70B
# Versatile is Enterprise-only on Groq, so your account may have no Meta chat model.
GROQ_API_KEY=your_groq_api_key

# Paid is the default (every usable Meta vision model is paid or account-gated).
# Only Meta-published models are ever called, on every provider.
MODEL_ACCESS_TIER=paid

# Failover order. Groq has no image input, so it is last and text-only.
PROVIDER_PRIORITY=openrouter,cloudflare-workers-ai,nvidia-nim,blockrun,modal,groq

# Outbound network is restricted to allowlisted inference hosts only.
ALLOW_OUTBOUND_NETWORK=false
LOCAL_SOURCE_DIR=./intentlens-data/sources

# Optional Meta components (resource-gated, not required for MVP)
SAM2_ENABLED=false
DINOV2_ENABLED=false
FAISS_ENABLED=false
