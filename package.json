{
  "name": "intentlens",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Task-aware visual grounding prototype: phone/PC camera + command + any vision provider + local ElectroCom61 component recognition",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node scripts/run-source-tests.mjs",
    "test:source": "node scripts/run-source-tests.mjs",
    "test:all": "node --test",
    "pwa:prepare": "node scripts/prepare-pwa.mjs",
    "pwa:serve": "node scripts/serve-pwa.mjs",
    "eval:accuracy": "node scripts/eval-accuracy.mjs",
    "test:accuracy": "node scripts/eval-runtime-accuracy.mjs --min 0.9 --min-stage 0.9 --min-class 0.9",
    "bench:tracking": "node scripts/bench-tracking.mjs",
    "cli": "node cli/intentlens.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
